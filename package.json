{
  "name": "recipai-app",
  "version": "2.29.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "check:all": "./scripts/check.sh",
    "check": "biome check --write . --max-diagnostics=50",
    "check:ci": "biome ci .",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "prepare": "husky",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "release": "release-it",
    "release:pipeline": "./scripts/release.sh",
    "docs": "python3 -m mkdocs serve",
    "docs:build": "python3 -m mkdocs build --strict",
    "tunnel": "ngrok http 3000"
  },
  "dependencies": {
    "@axiomhq/js": "^2.0.0",
    "@better-auth/passkey": "~1.6.33",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^6.0.0",
    "@huggingface/transformers": "^4.3.1",
    "@serwist/next": "^9.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.22",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "~1.6.33",
    "better-auth-telegram": "^2.0.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^7.5.0",
    "imagekit": "^6.0.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "posthog-js": "^1.438.21",
    "posthog-node": "^5.57.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-image-crop": "^11.1.2",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@release-it/conventional-changelog": "^12.0.2",
    "@sentry/nextjs": "^11.9.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "release-it": "^21.1.1",
    "serwist": "^9.5.13",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version} [skip ci]"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits"
        },
        "infile": false
      }
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    }
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@better-auth/core": "1.6.33"
  }
}
