NEXT_PUBLIC_SENTRY_DSN=
GEMINI_API_KEY=
# Optional paid fallback — used only when every free Gemini model fails.
OPENAI_API_KEY=
# Embedding host chain (ordered, comma-separated). `local` = in-process e5-small;
# `http:<url>` = remote /api/embed. Pi: local. Vercel:
# http:https://recipai.pp.ua
EMBED_PROVIDERS=local
# Shared secret guarding /api/embed between deployments.
EMBED_SHARED_SECRET=
# Optional persistent cache directory for the local e5-small model.
EMBED_MODEL_CACHE_DIR=
SCRAPE_DO_TOKEN=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_PLACEHOLDER_IMAGE_URL=
# Runtime URL; use Supabase transaction pooling (port 6543) on Vercel. Override
# this variable with a direct/session port-5432 URL when running db:migrate.
DATABASE_URL=
NEXT_PUBLIC_BETTER_AUTH_URL=
# Public external-auth origin; this value is not a secret. The localhost value
# is fine for ordinary development; account linking always needs a separate
# origin, such as https://auth.recipai.pp.ua in production.
NEXT_PUBLIC_EXTERNAL_AUTH_URL=http://localhost:3000
# Session signing secret. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PHANTOMJS_API_KEY=
# Instagram, TikTok, YouTube, and X social imports. Omit to disable them.
APIFY_TOKEN=
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_OIDC_CLIENT_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Shared secret for verifying Telegram webhook requests. Generate with:
#   openssl rand -hex 32
# Then register it: curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#   -d "url=<APP_URL>/api/telegram-bot" -d "secret_token=<value>"
#
# SINGLE WEBHOOK HOST: a bot token allows only ONE webhook URL — the last
# setWebhook call wins. Pick the instance that owns it (check with getWebhookInfo)
# and set this var in THAT instance's env. The bot still works either way because
# all instances share one Postgres, but the secret check is only active on the
# webhook host; an instance without the var set fails open (unauthenticated).
TELEGRAM_WEBHOOK_SECRET=
REDIS_URL=
# Web push (parse-complete notifications). Generate a pair with:
#   bunx web-push generate-vapid-keys
# Omit all four to disable push entirely.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# PostHog Cloud EU (product analytics + session replay). Omit to disable.
NEXT_PUBLIC_POSTHOG_KEY=
# Axiom structured server logs (AI cost, rate limits). Omit to disable.
AXIOM_TOKEN=
AXIOM_DATASET=recipai
# Telemetry sends only in production. Set these to "1" to exercise PostHog/Axiom
# locally for verification; leave unset for normal dev (nothing is sent).
TELEMETRY_DEV=
NEXT_PUBLIC_TELEMETRY_DEV=
# Extra origins allowed to hit the dev server cross-origin (e.g. your LAN IP, to
# test from a phone). Comma-separated. Dev-only; leave unset otherwise.
DEV_ORIGINS=
